---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import '../styles/global.css';
import SkipLink from '../components/SkipLink.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { pli } from '../transitions/pli';

interface Props {
  /** Titre court de la page ; « Origami Digital » pour l'accueil. */
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const titreComplet = title === 'Origami Digital' ? 'Origami Digital · Studio web expérimental' : `${title} · Origami Digital`;
const canonique = new URL(Astro.url.pathname, Astro.site);

// Sans JavaScript, le bouton du menu mobile est inerte : on affiche plutôt la nav bureau.
// Rendu via set:html pour échapper à la portée (data-astro-cid-*) des styles de Header.astro ;
// !important compense la spécificité ajoutée par cet attribut de portée.
const styleSansJS =
  '<style>@media (max-width: 47.99rem) { .nav-bureau { display: block !important; } .nav-bureau ul { flex-wrap: wrap !important; gap: var(--space-xs) !important; } .menu-mobile { display: none !important; } }</style>';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Origami Digital" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta name="theme-color" content="#0D0D12" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    {/* latin-ext couvre les caractères comme le « ō » de Kōri ; seul le sous-ensemble latin est préchargé */}
    <Font cssVariable="--font-display" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-body" preload={[{ subset: 'latin' }]} />
    <noscript set:html={styleSansJS} />
    <ClientRouter />
  </head>
  <body>
    <SkipLink />
    <Header />
    <main id="contenu" transition:animate={pli}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
